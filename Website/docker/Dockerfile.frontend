# Multi-stage frontend: Vite build → nginx (proxies /api to backend).
# Build from repo root:
#   docker build -f Website/docker/Dockerfile.frontend -t toll-frontend .

FROM node:22-alpine AS build
WORKDIR /app
COPY Website/frontend/package.json Website/frontend/package-lock.json* ./
RUN npm ci || npm install
COPY Website/frontend/ ./
# Empty → browser calls same-origin /api (nginx proxies to backend).
ENV VITE_API_URL=
RUN npm run build

FROM nginx:1.27-alpine
COPY Website/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
