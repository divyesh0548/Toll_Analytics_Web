# Copy to Website/backend/.env and fill in values.
# This is the ONLY env file the Website worker / Docker backend should need.
#
# Canonical keys (do not re-add legacy aliases):
#   DB_*                  — Flask / toll_analytics
#   RDS_*                 — nhit DB (header keywords + checkpostmaster)
#   Toll_Analytics_DB     — metrics DB name (often same as DB_NAME)
#   Exception_Metrics_Table
#   Source_DB_NAME        — submissions / snt_form
#   exceptions_Table_NAME — usually "submissions"
#
# Removed duplicates (no longer used):
#   Table_NAME → exceptions_Table_NAME
#   Plaza_analytics_DB_NAME → Toll_Analytics_DB (fallback DB_NAME)
#   Plaza_analytics_Table_NAME → Exception_Metrics_Table
#   Checkpost_DB_NAME → RDS_DB_NAME
#   Checkpost_Table_NAME → RDS_TABLE_NAME

# --- Flask / app ---
FLASK_ENV=production
FLASK_APP=run:app
SECRET_KEY=change-me
SITEADMIN_EMAIL=
SITEADMIN_PASSWORD=
# Comma-separated browser origins allowed to call /api (ngrok demo + local)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,https://mariah-pernickety-phraseologically.ngrok-free.dev
# 1 = show Exceptions page + Audit metrics-source toggle (UI only).
# 0 = hide them; Audit reads audit_exception_* only.
# Result tables (metrics + output files always match):
#   Exceptions page → audit_exception_metrics + audit_exception_output_files
#   File Upload     → pipeline_audit_exception_metrics + pipeline_audit_exception_output_files
Development_Exceptions=0
# 1 = upload outputs to S3 and write the matching metrics table above.
# 0 = keep outputs on the server for download; do not update metrics.
PUBLISH_EXCEPTION_RESULTS=1

# --- Primary analytics DB (Flask SQLAlchemy) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=toll_analytics

# --- RDS / nhit (Full Exempt header keywords + checkpost) ---
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USER=
RDS_PASSWORD=
RDS_TABLE_NAME=checkpostmaster

# --- Metrics DB (table name is set by the website worker per job) ---
Toll_Analytics_DB=toll_analytics
# Optional default for standalone CLI runs only. Website File Upload /
# Exceptions jobs always set Exception_Metrics_Table + EXCEPTION_OUTPUT_FILES_TABLE
# together (do not set only one of them here).
# Exception_Metrics_Table=audit_exception_metrics

# --- Source / submissions DB (E4 ETC-VRN download, etc.) ---
Source_DB_NAME=
exceptions_Table_NAME=submissions

# --- AWS S3 (exception / analytics job inputs + outputs) ---
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web scrape (E5, E6, …) — same keys for every program
# 1 = enable Chrome scrape; 0 = off
SCRAPE_ENABLED=1
# 0 = Chrome in this process/container; 1 = Selenium Grid (hub + Chrome nodes)
SCRAPE_USE_GRID=1
# Grid hub URL (used only when SCRAPE_USE_GRID=1)
# Host Python:        http://localhost:4444/wd/hub
# Docker backend:     http://host.docker.internal:4444/wd/hub  (hub port published)
# Same Compose net:   http://selenium-hub:4444/wd/hub
SCRAPE_GRID_URL=http://localhost:4444/wd/hub
# Chrome node containers to auto-start against the existing hub
SCRAPE_MAX_NODES=3
# Browser sessions on each node. Total sessions = nodes × this value.
SCRAPE_MAX_CONCURRENCY=3
# 1 = spawn auto-chrome-node-* containers; 0 = use already-registered nodes only
SCRAPE_AUTO_MANAGE_NODES=1
# 1 = headless Chrome (no window)
SCRAPE_HEADLESS=1
# Optional overrides (defaults usually fine)
# SELENIUM_HUB_CONTAINER=selenium-hub
# SELENIUM_NETWORK=selenium-grid
# SELENIUM_NODE_IMAGE=selenium/node-chrome:latest

# --- Path overrides (Docker sets these; leave empty for local Windows checkout) ---
TOLL_REPO_ROOT=
EXCEPTION_PROGRAMS_ROOT=
PLAZA_DB_UPDATE_ROOT=
WEBSITE_BACKEND_ROOT=
