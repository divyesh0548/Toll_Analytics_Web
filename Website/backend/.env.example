# Flask
FLASK_ENV=development
FLASK_APP=run:app
SECRET_KEY=change-me-in-production

# Application database (created by scripts/create_db.py)
DB_HOST=db-1.example.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=toll_analytics
# Optional: maintenance DB used only to CREATE DATABASE
# DB_ADMIN_DB=postgres

# Siteadmin bootstrap
SITEADMIN_EMAIL=you@example.com
SITEADMIN_PASSWORD=

# Login email (optional — without SMTP, temp passwords print to backend console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bots.admin@example.com
# SMTP_PASS=your-app-password
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=bots.admin@example.com
# SENDER_EMAIL=
# SENDER_PASSWORD=

# Analytics data source (optional overrides)
# ANALYTICS_DB_NAME=toll_analytics
# ANALYTICS_TABLE=toll_analysis_main
# GAP_DISTRIBUTION_TABLE=gap_distribution_per_lane
# EXEMPT_DISTRIBUTION_TABLE=exempt_distribution_per_lane
