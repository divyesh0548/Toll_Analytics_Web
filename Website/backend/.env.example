# Copy to Website/backend/.env and fill in values.
# This is the ONLY env file the Website worker / Docker backend should need.

# --- Flask / app ---
FLASK_ENV=production
FLASK_APP=run:app
SECRET_KEY=change-me
SITEADMIN_EMAIL=
SITEADMIN_PASSWORD=
# Comma-separated browser origins allowed to call /api (ngrok demo + local)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,https://mariah-pernickety-phraseologically.ngrok-free.dev
# Show classic Exception uploads page (run each exception separately) in the UI
SHOW_EXCEPTION_UPLOADS=0

# --- Primary analytics DB (Flask SQLAlchemy) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=toll_analytics

# --- RDS / nhit (Full Exempt header keywords) ---
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USER=
RDS_PASSWORD=
RDS_TABLE_NAME=

# Metrics DB name (often same as DB_NAME)
Toll_Analytics_DB=toll_analytics
Exception_Metrics_Table=audit_exception_metrics

# --- Source / submissions DB (E4 ETC-VRN download, etc.) ---
Source_DB_NAME=
exceptions_Table_NAME=

# --- E4 legacy keys (merge from old E4/.env) ---
Table_NAME=
Plaza_analytics_DB_NAME=
Plaza_analytics_Table_NAME=
Checkpost_DB_NAME=
Checkpost_Table_NAME=

# --- AWS S3 (exception / analytics job inputs + outputs) ---
AWS_S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Scraping ---
# EXCEPTION_USE_SELENIUM: E5/E6 historically treat this as "use Selenium Grid".
# For normal local Chrome inside the backend container, keep Grid OFF:
EXCEPTION_USE_SELENIUM=0
E6_USE_SELENIUM_GRID=0

# --- Path overrides (Docker sets these; leave empty for local Windows checkout) ---
TOLL_REPO_ROOT=
EXCEPTION_PROGRAMS_ROOT=
PLAZA_DB_UPDATE_ROOT=
WEBSITE_BACKEND_ROOT=
