# Flask
FLASK_ENV=development
FLASK_APP=run:app
SECRET_KEY=change-me-in-production

# Application database (created by scripts/create_db.py)
DB_HOST=db-1.example.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=toll_analytics
# Optional: maintenance DB used only to CREATE DATABASE
# DB_ADMIN_DB=postgres

# Analytics data source (optional overrides)
# ANALYTICS_DB_NAME=toll_analytics
# ANALYTICS_TABLE=toll_analysis_main
# GAP_DISTRIBUTION_TABLE=gap_distribution_per_lane
# EXEMPT_DISTRIBUTION_TABLE=exempt_distribution_per_lane
